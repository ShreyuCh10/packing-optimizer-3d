# ==============================================================================
# 3D Packing Optimizer - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in your project root or backend directory:
#   cp .env.example .env
#
# Replace the placeholder values below with your Azure OpenAI credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Azure OpenAI Service Configuration
# ------------------------------------------------------------------------------

# The HTTPS endpoint of your Azure OpenAI resource.
# Found in: Azure Portal -> Azure OpenAI resource -> "Keys and Endpoint"
# Example: https://my-openai-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Your Azure OpenAI API Key.
# Found in: Azure Portal -> Azure OpenAI resource -> "Keys and Endpoint" (Key 1 or Key 2)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# The deployment name you assigned when deploying the model in Azure AI Foundry / Azure OpenAI Studio.
# Found in: Azure OpenAI Studio -> Deployments -> Deployment Name
# Example: gpt-4o, gpt-4o-mini, gpt-4-turbo
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# The underlying model name for the deployment.
# Example: gpt-4o, gpt-4o-mini, gpt-4
AZURE_OPENAI_MODEL_NAME=gpt-4o

# The Azure OpenAI REST API version.
# Supported versions: 2024-02-01, 2024-06-01, 2024-08-01-preview, 2024-10-21
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional: Sampling temperature for extraction (0.0 recommended for deterministic parameter parsing)
AZURE_OPENAI_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 2. Application & Database Configuration (Optional)
# ------------------------------------------------------------------------------

# Path to the packaging catalog SQLite database.
# Default if unset: backend/data/packaging.db
SQLITE_DB_PATH=backend/data/packaging.db

# FastAPI Server Host & Port (defaults to 127.0.0.1:8000)
API_HOST=127.0.0.1
API_PORT=8000

