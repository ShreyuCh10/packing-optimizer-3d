# ==============================================================================
# 3D Packing Optimizer - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in your project root or backend directory:
#   cp .env.example .env
#
# Replace the placeholder values below with your Azure OpenAI credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Azure OpenAI Service Configuration
# ------------------------------------------------------------------------------

# The HTTPS endpoint of your Azure OpenAI resource.
# Found in: Azure Portal -> Azure OpenAI resource -> "Keys and Endpoint"
# Example: https://my-openai-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Your Azure OpenAI API Key.
# Found in: Azure Portal -> Azure OpenAI resource -> "Keys and Endpoint" (Key 1 or Key 2)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# The deployment name you assigned when deploying the model in Azure AI Foundry / Azure OpenAI Studio.
# Found in: Azure OpenAI Studio -> Deployments -> Deployment Name
# Example: gpt-4o, gpt-4o-mini, gpt-4-turbo
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# The underlying model name for the deployment.
# Example: gpt-4o, gpt-4o-mini, gpt-4
AZURE_OPENAI_MODEL_NAME=gpt-4o

# The Azure OpenAI REST API version.
# Supported versions: 2024-02-01, 2024-06-01, 2024-08-01-preview, 2024-10-21
AZURE_OPENAI_API_VERSION=2024-02-01

# Optional: Sampling temperature for extraction (0.0 recommended for deterministic parameter parsing)
AZURE_OPENAI_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 2. Azure AI Foundry OpenAI-Compatible Endpoint (Package Recommendation Agent)
# ------------------------------------------------------------------------------

# Use the OpenAI-compatible v1 endpoint URL ending in /openai/v1/.
# Example: https://my-foundry-resource.services.ai.azure.com/openai/v1/
AZURE_FOUNDRY_OPENAI_BASE_URL=
# API key for the Azure AI Foundry model endpoint.
AZURE_FOUNDRY_OPENAI_API_KEY=

# Model deployment name exposed by the endpoint.
AZURE_FOUNDRY_OPENAI_MODEL=gpt-5.1

# ------------------------------------------------------------------------------
# 3. Application & Database Configuration (Optional)
# ------------------------------------------------------------------------------

# Path to the packaging catalog SQLite database.
# Default: backend/data/products.db
SQLITE_DB_PATH=backend/data/products.db

# Comma-separated browser origins allowed to call the API.
# Keep localhost entries for development; use your deployed frontend origin in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared API key for trusted deployments behind a server-side proxy.
# If configured, requests to /api/* must include X-API-Key. Do not embed a secret
# API key in a public browser bundle; use user authentication or a trusted proxy.
# The trusted proxy must also set X-Authenticated-User for workflow requests and
# strip any client-supplied value before adding its authenticated identity.
API_KEY=

# Number of days before inactive chatbot conversations are deleted on access.
CHAT_CONVERSATION_TTL_DAYS=30

# FastAPI Server Host & Port (defaults to 127.0.0.1:8000)
API_HOST=127.0.0.1
API_PORT=8000
